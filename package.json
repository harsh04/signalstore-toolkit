{
  "name": "signalstore-toolkit",
  "version": "0.1.0",
  "description": "Production-grade utilities for NgRx Signal Store — request status, entity sync, pagination, API method factories, and search/filter pipelines.",
  "license": "MIT",
  "author": "Harsh <harsh04@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/harsh04/signalstore-toolkit.git"
  },
  "keywords": [
    "ngrx",
    "signals",
    "signal-store",
    "angular",
    "state-management",
    "ngrx-signals",
    "signalstore",
    "toolkit",
    "entity",
    "pagination",
    "rxmethod"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@ngrx/operators": ">=17.0.0",
    "@ngrx/signals": ">=17.0.0",
    "rxjs": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@ngrx/operators": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^20.0.0",
    "@ngrx/operators": "^20.0.0",
    "@ngrx/signals": "^20.0.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
